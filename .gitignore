
# Julia
Manifest.toml

# Claude Code plugin artifacts
.claude/docs/
.claude/tools/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
docs/literature/**/*.pdf
docs/literature/quantum_simulation/.browser-profile/

# Claude Code local state
.claude/scheduled_tasks.lock
docs/literature/*_src/
docs/literature/*.pdf
bench/out/

# Physics sources are LOCAL ONLY — never committed (CLAUDE.md rule 4).
# docs/physics/ commits the Markdown DISTILLATIONS; the PDFs they distil are
# third-party copyrighted works (journal papers, book drafts) and this repo is
# public, so committing them would be redistribution. Keep the PDF locally so
# every citation stays re-checkable; commit only the .md that pins the
# equation/page. The runtests citation lint checks `docs/physics/*.md` paths
# only, so it is unaffected.
docs/physics/*.pdf
docs/physics/**/*.pdf
